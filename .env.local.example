# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Canva Connect integration ---------------------------------------------
# From the Canva Developer Portal: Your integrations > your integration >
# Configuration > Credentials.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Minted once by visiting /api/canva/auth while signed in to the Canva account
# that owns the brand template. The callback page prints the value to paste here.
# Canva rotates this token on every refresh; the rotated copy lives in the token
# store, and this value is only the seed used after a cold start.
CANVA_REFRESH_TOKEN=

# The brand template to autofill. This is the ID from the BRAND TEMPLATE url,
# not the design URL:
#   https://www.canva.com/brand/brand-templates/<CANVA_TEMPLATE_ID>
CANVA_TEMPLATE_ID=

# Optional alternative to CANVA_TEMPLATE_ID: autofill straight from a normal
# design that has tagged data fields, skipping brand templates entirely.
# Take the ID from https://www.canva.com/design/<ID>/edit
# When set, this wins over CANVA_TEMPLATE_ID.
CANVA_SOURCE_DESIGN_ID=

# Name of the image data field inside that template. Must match exactly.
# Verify it by visiting /api/canva/template — see the README.
CANVA_IMAGE_FIELD_NAME=image_frame_name

# JPEG quality for the export, 1-100. Optional, defaults to 90.
CANVA_EXPORT_QUALITY=90

# Protects /api/canva/auth and /api/canva/callback. Required in production:
# append ?secret=<value> when visiting those routes.
CANVA_SETUP_SECRET=

# --- Resend email ----------------------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain you have verified in Resend. Until then, Resend's sandbox
# address below works but can only deliver to your own account email.
EMAIL_FROM=Princess Butterflies <onboarding@resend.dev>

# --- Event copy ------------------------------------------------------------
# Shown on the kiosk landing screen and in the email subject line.
EVENT_NAME=Jas & Thad's Baby Shower

# --- App -------------------------------------------------------------------
# Public origin of this app. Used to build the Canva OAuth redirect URI, which
# must exactly match a redirect URL registered in the Developer Portal.
APP_URL=http://127.0.0.1:3000

# --- Token storage (required on serverless) ---------------------------------
# Canva rotates the refresh token on every use. On Vercel/Netlify the filesystem
# is ephemeral and requests hit different instances, so the rotated token needs
# somewhere durable to live or the booth stops working after a cold start.
#
# The store is picked automatically, first match wins:
#   1. Postgres  — DATABASE_URL / POSTGRES_URL (Neon, Supabase, any Postgres).
#                  Vercel's Neon integration sets these for you; nothing to do.
#                  A `canva_tokens` table is created on first write.
#   2. Upstash   — UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   3. File      — .canva-token.json (local dev / long-running Node process)
#   4. Memory    — last resort, lost on restart
#
# Only set these if you're NOT using Vercel's Neon integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Force the token store onto a specific database, separate from DATABASE_URL.
# CANVA_TOKEN_DATABASE_URL=

# Override the local token file path if you need to (e.g. /tmp/canva-token.json).
# CANVA_TOKEN_FILE=.canva-token.json
